VITE_APP_VERSION=3.13.0
VITE_FRONTEND_VERSION=3.13.0

# Google Analytics Configuration
# Get your Measurement ID from: https://analytics.google.com/
VITE_GA_MEASUREMENT_ID=G-NY3H7YR52Y

# Enable Google Analytics (set to 'true' only in production)
# This provides an extra safety layer - analytics only runs if BOTH conditions are met:
# 1. Production build (npm run build)
# 2. VITE_ENABLE_ANALYTICS=true
# Leave as 'false' for development, staging, or to temporarily disable analytics
VITE_ENABLE_ANALYTICS=false

# FluxOS Audit Viewer - allows fluxteam to query audit logs (separate from event tracking)
VITE_AUDIT_URL=https://cloudaudit.runonflux.io

# Console API base URL — used only for the SSO handoff: when the Console opens
# this UI with a #flux-handoff=<token> fragment, we exchange that one-time token
# here for a zelidauth session. Must match the Console deployment.
VITE_CONSOLE_API_URL=https://api.console.runonflux.com/api/v1
